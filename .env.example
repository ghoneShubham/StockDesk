# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is already in .gitignore.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
CSRF_TRUSTED_ORIGINS=
# Production only (ignored by dev settings):
# SECURE_SSL_REDIRECT=True

# --- Database (PostgreSQL only) ---
DB_NAME=stockdesk_dev
DB_USER=stockdesk
DB_PASSWORD=stockdesk_dev_pw
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Company / branding (shown on invoice PDFs) ---
COMPANY_NAME=StockDesk
COMPANY_ADDRESS=12 Market Road, Your City
COMPANY_PHONE=+91-90000-00000
COMPANY_GSTIN=

# Invoice PDF engine: xhtml2pdf (default, Windows-friendly) or weasyprint (Linux)
INVOICE_PDF_ENGINE=xhtml2pdf

# --- Razorpay (TEST MODE ONLY — never put live keys here) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (SES SMTP credentials in production) ---
DEFAULT_FROM_EMAIL=no-reply@stockdesk.local
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
LOW_STOCK_ALERT_RECIPIENTS=owner@example.com

# --- AWS S3 (production / staging) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
BACKUP_RETENTION_DAYS=7
BACKUP_S3_PREFIX=backups

# --- Monitoring (optional) ---
SENTRY_DSN=
