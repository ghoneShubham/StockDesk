[Unit]
Description=StockDesk nightly pg_dump to S3
After=network.target postgresql.service

[Service]
Type=oneshot
User=stockdesk
Group=www-data
WorkingDirectory=/opt/stockdesk/app
EnvironmentFile=/opt/stockdesk/app/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
# stockdesk role needs pg_dump; password comes from .env via the command
ExecStart=/opt/stockdesk/venv/bin/python manage.py backup_database
Nice=10
