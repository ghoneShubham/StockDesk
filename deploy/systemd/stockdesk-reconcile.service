[Unit]
Description=StockDesk stock reconciliation (email on drift)
After=network.target postgresql.service

[Service]
Type=oneshot
User=stockdesk
Group=www-data
WorkingDirectory=/opt/stockdesk/app
EnvironmentFile=/opt/stockdesk/app/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/opt/stockdesk/venv/bin/python manage.py reconcile_stock --email-on-drift
Nice=10
