# Production environment — copy to /opt/stockdesk/app/.env on the EC2 host.
# NEVER commit the real filled file.

# --- Django core (DEBUG must stay False; prod.py also forces False) ---
DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your.subdomain.example.com
DJANGO_TIME_ZONE=Asia/Kolkata
CSRF_TRUSTED_ORIGINS=https://your.subdomain.example.com
SECURE_SSL_REDIRECT=True

# --- Database (Postgres on the same EC2 instance — no RDS) ---
DB_NAME=stockdesk
DB_USER=stockdesk
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Company / branding ---
COMPANY_NAME=StockDesk
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_GSTIN=
INVOICE_PDF_ENGINE=xhtml2pdf

# --- Razorpay (leave empty until Day 15 Module F) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email / SES SMTP (Day 14) ---
DEFAULT_FROM_EMAIL=no-reply@your.subdomain.example.com
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Comma-separated; used for low-stock, dead-stock, and reconcile-drift alerts
LOW_STOCK_ALERT_RECIPIENTS=owner@example.com

# --- S3 media + backups (Day 14) ---
# IAM user: scoped to this one bucket only (not AmazonS3FullAccess)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
BACKUP_RETENTION_DAYS=7
BACKUP_S3_PREFIX=backups

SENTRY_DSN=
