# Staging environment — copy to /opt/stockdesk/app/.env.staging
# Separate database from production. NEVER commit the filled file.

DJANGO_SECRET_KEY=replace-with-different-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=YOUR_PUBLIC_IP,localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
CSRF_TRUSTED_ORIGINS=http://YOUR_PUBLIC_IP:8080
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- Separate Postgres database ---
DB_NAME=stockdesk_staging
DB_USER=stockdesk
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

COMPANY_NAME=StockDesk Staging
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_GSTIN=
INVOICE_PDF_ENGINE=xhtml2pdf

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

DEFAULT_FROM_EMAIL=no-reply@your.subdomain.example.com
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
LOW_STOCK_ALERT_RECIPIENTS=

# Prefer a separate bucket or leave empty for local media_staging/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
BACKUP_RETENTION_DAYS=7
BACKUP_S3_PREFIX=backups-staging

SENTRY_DSN=
